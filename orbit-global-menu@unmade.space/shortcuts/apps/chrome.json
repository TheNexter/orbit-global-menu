{
  "format": 1,
  "app": "chrome",
  "name": "Google Chrome",
  "identifiers": [
    "com.google.Chrome.desktop",
    "com.google.Chrome",
    "google-chrome.desktop",
    "google-chrome",
    "google-chrome-stable",
    "Google Chrome"
  ],
  "menus": [
    {
      "label": "File",
      "items": [
        {"label": "New Tab", "shortcut": "<Ctrl>T"},
        {"label": "New Window", "shortcut": "<Ctrl>N"},
        {"label": "New Incognito Window", "shortcut": "<Ctrl><Shift>N"},
        {"label": "Reopen Closed Tab", "shortcut": "<Ctrl><Shift>T"},
        {"label": "Open File", "shortcut": "<Ctrl>O"},
        {"label": "Open Location", "shortcut": "<Ctrl>L"},
        {"separator": true},
        {"label": "Save Page As", "shortcut": "<Ctrl>S"},
        {"label": "Print Page", "shortcut": "<Ctrl>P"},
        {"separator": true},
        {"label": "Close Tab", "shortcut": "<Ctrl>W"},
        {"label": "Close Window", "shortcut": "<Ctrl><Shift>W"}
      ]
    },
    {
      "label": "Edit",
      "items": [
        {"label": "Undo", "shortcut": "<Ctrl>Z"},
        {"label": "Redo", "shortcut": "<Ctrl>Y"},
        {"label": "Redo (Alternative)", "shortcut": "<Ctrl><Shift>Z"},
