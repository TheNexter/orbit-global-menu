        {"label": "Select Tab 5", "shortcut": "<Ctrl>5"},
        {"label": "Select Tab 6", "shortcut": "<Ctrl>6"},
        {"label": "Select Tab 7", "shortcut": "<Ctrl>7"},
        {"label": "Select Tab 8", "shortcut": "<Ctrl>8"},
        {"label": "Select Last Tab", "shortcut": "<Ctrl>9"},
